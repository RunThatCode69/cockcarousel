# Copy to .env (never commit .env). One-time values from developer.apple.com / appstoreconnect.apple.com
APPLE_TEAM_ID=XXXXXXXXXX                      # developer.apple.com → Membership → Team ID
ASC_KEY_ID=XXXXXXXXXX                         # App Store Connect → Users and Access → Integrations → App Store Connect API → Generate key (Admin)
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=./AuthKey.p8                     # put the downloaded .p8 at ios-app/fastlane/AuthKey.p8
